# Optional fallback when no collection is used. Comma-separated IDs or URLs.
WORKSHOP_MOD_IDS=

POLL_INTERVAL_SECONDS=180
ONLINE_STABLE_SECONDS=90
DATA_DIR=/data
LOG_LEVEL=info

